# Copy this file to .env and adjust the values for your machine.

APP_NAME="EXECOM Logistics"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost/EXECOMLOGISTICS
APP_TIMEZONE=Asia/Manila
APP_CURRENCY=₱

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=execomlogistics_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

SESSION_NAME=EXECOM_SID
# Auto-logout in seconds. 0 = never (stay signed in until Logout / browser closed)
SESSION_IDLE_TIMEOUT=0
SESSION_ABSOLUTE_TIMEOUT=0

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
